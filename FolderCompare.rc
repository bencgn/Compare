#include <windows.h>
#include "resource.h"

IDI_APP ICON "FolderCompare.ico"

// Manifest
1 24 "FolderCompare.manifest"

// Version info (shown in Explorer > Properties > Details)
1 VERSIONINFO
FILEVERSION 3,3,0,0
PRODUCTVERSION 3,3,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "bencgn\0"
      VALUE "FileDescription",  "FolderCompare - Folder Comparison Tool\0"
      VALUE "FileVersion",      "3.3.0.0\0"
      VALUE "InternalName",     "FolderCompare\0"
      VALUE "LegalCopyright",   "Copyright (c) 2026 bencgn. MIT License.\0"
      VALUE "OriginalFilename", "FolderCompare.exe\0"
      VALUE "ProductName",      "FolderCompare\0"
      VALUE "ProductVersion",   "3.3.0.0\0"
      VALUE "Comments",         "https://github.com/bencgn/Compare\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
